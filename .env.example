# StaliRouter environment contract
# Fork optimized for api.stali.vn — see README.md

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/stalirouter

# Stali-only mode (default ON — set false to unlock full upstream 9router feature set)
STALI_ONLY_MODE=true
STALI_ALLOWED_BASE_HOSTS=api.stali.vn
# Client UI mirror (unset = Stali-only UI)
NEXT_PUBLIC_STALI_ONLY_MODE=true
# CLI advanced menus (Providers/Combos/CLI Tools legacy)
# STALI_ROUTER_ADVANCED=1

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Public base URL (dashboard + local endpoint resolution)
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Optional cloud sync (disable if unused)
# CLOUD_URL=
# NEXT_PUBLIC_CLOUD_URL=

# Optional outbound proxy for upstream Stali calls
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG (disabled in Stali-only by default)
# SEARXNG_URL=http://searxng:8080/search

# INSTANCE_NAME=stalirouter
